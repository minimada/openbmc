+#include <boost/asio/deadline_timer.hpp>
+#include <boost/container/flat_map.hpp>
+#include <sensor.hpp>
+
+#include <chrono>
+#include <limits>
+#include <memory>
+#include <string>
+#include <vector>
+
+struct MiscSensor : public Sensor
+{
+    MiscSensor(std::shared_ptr<sdbusplus::asio::connection>& conn,
+               boost::asio::io_service& io, const std::string& name,
+               const std::string& sensorConfiguration,
+               sdbusplus::asio::object_server& objectServer,
+               std::vector<thresholds::Threshold>&& thresholds, uint8_t busId,
+               uint8_t address, uint8_t tempCmd, uint8_t tempSrc,
+               uint8_t readBytes);
+    ~MiscSensor() override;
+
+    void checkThresholds(void) override;
+    void read(void);
+    void init(void);
+
+    uint8_t busId;
+    uint8_t address;
+    uint8_t tempCmd;
+    uint8_t tempSrc;
+    uint8_t readBytes;
+
+  private:
+    int getSOCInfoBlock(uint8_t* data);
+    sdbusplus::asio::object_server& objectServer;
+    boost::asio::deadline_timer waitTimer;
+    uint8_t msgId;
+};
