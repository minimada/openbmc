+
+void GpioSensor::gpioEventHandler(bool state)
+{
+    double nvalue = static_cast<double>(state);
+    if (value != nvalue)
+    {
+        updateValue(nvalue);
+    }
+}
+
+void GpioSensor::waitForGPIOEvent(const std::string& name, gpiod::line& line,
+                                  boost::asio::posix::stream_descriptor& event)
+{
+    std::weak_ptr<GpioSensor> weakRef = weak_from_this();
+    event.async_wait(
+        boost::asio::posix::stream_descriptor::wait_read,
+        [weakRef, &name, &line, &event](const boost::system::error_code ec) {
+            if (ec)
+            {
+                std::cerr << name << " fd handler error: " << ec.message()
+                          << "\n";
+                return;
+            }
+            std::shared_ptr<GpioSensor> self = weakRef.lock();
+            gpiod::line_event line_event = line.event_read();
+            if (!self)
+            {
+                std::cerr << name << "get async_wait self failed.\n";
+                return;
+            }
+            self->gpioEventHandler(line_event.event_type ==
+                                  gpiod::line_event::RISING_EDGE);
+            self->waitForGPIOEvent(name, line, event);
+        });
+}
+
+bool GpioSensor::requestGPIOEvents(void)
+{
+    // Find the GPIO line
+    gpioLine = gpiod::find_line(name);
+    if (!gpioLine)
+    {
+        std::cerr << "Failed to find the " << name << " line\n";
+        return false;
+    }
+
+    try
+    {
+        gpioLine.request(
+            {"gpio-sensor", gpiod::line_request::EVENT_BOTH_EDGES, {}});
+    }
+    catch (const std::exception& e)
+    {
+        std::cerr << "Failed to request events for " << path << ": " << e.what()
+                  << "\n";
+        return false;
+    }
+
+    int gpioLineFd = gpioLine.event_get_fd();
+    if (gpioLineFd < 0)
+    {
+        std::cerr << "Failed to get " << path << " fd"
+                  << "\n";
+        return false;
+    }
+
+    gpioEventDescriptor.assign(gpioLineFd);
+
+    waitForGPIOEvent(path, gpioLine, gpioEventDescriptor);
+    return true;
+}
