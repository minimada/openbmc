+Response Handler::multipartReceive(const pldm_msg* request,
+                                   size_t payloadLength)
+{
+    int payloadSize = sizeof(struct pldm_msg_hdr) +
+                      sizeof(struct pldm_rde_multipart_receive_resp);
+    uint32_t dataTransferHandle;
+    uint16_t operationId;
+    uint8_t transferOperation;
+    uint8_t transferFlag;
+    bool enableChecksum = false;
+
+    // check state
+    if (ctx.responderStatus != PLDM_RDE_RESPONDER_WAITING_FOR_NEXT)
+    {
+        lg2::error("payload not ready");
+        return ccOnlyResponse(request, PLDM_ERROR);
+    }
+
+    // decode request
+    auto rc = decode_rde_multipart_receive_req(
+        request, payloadLength, &dataTransferHandle, &operationId,
+        &transferOperation);
+    if (rc != PLDM_SUCCESS)
+    {
+        return CmdHandler::ccOnlyResponse(request, rc);
+    }
+    // print debug message
+    std::cerr << "=== multipartReceive request ===" << std::endl;
+    std::cerr << "Handle:" << std::to_string(dataTransferHandle);
+    std::cerr << ", OP ID:" << std::to_string(operationId) << std::endl;
+    std::cerr << "transferOperation:" << std::to_string(transferOperation)
+              << std::endl;
+
+    // check handle
+    if (ctx.transferHandle != dataTransferHandle)
+    {
+        lg2::error("not match handler, {HANDLE}", "HANDLE", dataTransferHandle);
+        return ccOnlyResponse(request, PLDM_ERROR);
+    }
+
+    // check operation
+    switch (transferOperation)
+    {
+        case PLDM_RDE_XFER_ABORT:
+            initResponderContext();
+            return ccOnlyResponse(request, PLDM_SUCCESS);
+        case PLDM_RDE_XFER_NEXT_PART:
+            if (ctx.transferred == 0)
+            {
+                rc = PLDM_ERROR;
+            }
+            break;
+        case PLDM_RDE_XFER_FIRST_PART:
+            if (ctx.transferred != 0)
+            {
+                rc = PLDM_ERROR;
+            }
+            break;
+        default:
+            rc = PLDM_ERROR;
+    }
+    if (rc != PLDM_SUCCESS)
+    {
+        lg2::error("invalid transferOperation: {OPERATION}", "OPERATION",
+                   transferOperation);
+        initResponderContext();
+        return CmdHandler::ccOnlyResponse(request, rc);
+    }
+    // calculate payload size, and copy to transfer temp
+    auto transDataSize = ctx.payload.size() - ctx.transferred;
+    auto cmdMaxPayloadSzie = ctx.transferChunkSize - payloadSize;
+    if (transDataSize > cmdMaxPayloadSzie)
+    {
+        transDataSize = cmdMaxPayloadSzie;
+    }
+
+    // handler transferFlag
+    if (ctx.transferred == 0) // start or start_end
+    {
+        if (ctx.payload.size() == transDataSize)
+        {
+            transferFlag = PLDM_RDE_START_AND_END;
+            // TODO: Add CRC32 checksum check, we should not eanble it before
+            // implement it
+            // enableChecksum = true;
+        }
+        else
+            transferFlag = PLDM_RDE_START;
+    }
+    else // middle or end
+    {
+        if (ctx.transferred + transDataSize < ctx.payload.size())
+            transferFlag = PLDM_RDE_MIDDLE;
+        else
+        {
+            transferFlag = PLDM_RDE_END;
+            // enableChecksum = true;
+        }
+    }
+
+    // handle request
+    payloadSize += transDataSize;
+    Response response(payloadSize, 0);
+    auto responsePtr = reinterpret_cast<pldm_msg*>(response.data());
+    // decode receive get some issue
+    // 1. CRC32 verify may not implement
+    // 2. assume payload length must larger than 64 byte
+    rc = encode_rde_multipart_receive_resp(
+        request->hdr.instance_id, PLDM_SUCCESS, transferFlag,
+        ++ctx.transferHandle, transDataSize, enableChecksum, 0,
+        ctx.payload.data() + ctx.transferred, responsePtr);
+    // print debug message
+    std::cerr << "=== multipartReceive response ===" << std::endl;
+    std::cerr << "Flag:" << std::to_string(transferFlag);
+    std::cerr << ", next Handle:" << std::to_string(ctx.transferHandle)
+              << std::endl;
+    std::cerr << "transDataSize:" << std::to_string(transDataSize) << ", ";
+    std::cerr << "transferred:" << std::to_string(ctx.transferred) << std::endl;
+    std::cerr << "RC:" << rc << ", ";
+    std::cerr << "payloadSize:" << payloadSize << std::endl;
+    std::cerr << "paloay size:" << ctx.payload.size() << std::endl;
+    std::cerr << "remains size:" << ctx.payload.size() - ctx.transferred
+              << std::endl;
+    if (rc != PLDM_SUCCESS)
+    {
+        return ccOnlyResponse(request, rc);
+    }
+    ctx.transferred += transDataSize;
+    // handle the end of transfer
+    if (transferFlag == PLDM_RDE_START_AND_END || transferFlag == PLDM_RDE_END)
+    {
+        ctx.responderStatus = PLDM_RDE_RESPONDER_READY;
+    }
+    return response;
+}
+
+void Handler::initOperationStatus()
+{
+    auto operation_ctx = std::make_unique<struct rde_operation>();
+    operation_ctx->operation_status = PLDM_RDE_OPERATION_INACTIVE;
+    operation_ctx->completion_time = 0xffffffff;
+    ctx.operation_ctx = std::move(operation_ctx);
+}
+
+Response Handler::RDEOperationStatus(const pldm_msg* request,
+                                     size_t payloadLength)
+{
+    uint32_t resourceId;
+    uint16_t operationId;
+    auto rc = decode_rde_operation_status_req(request, payloadLength,
+                                              &resourceId, &operationId);
+    if (rc != PLDM_SUCCESS)
+    {
+        std::cerr << "decode operation status failed\n";
+        return CmdHandler::ccOnlyResponse(request, rc);
+    }
+
+    // direct return operation context, not real implement
+    if (!ctx.operation_ctx)
+    {
+        std::cerr << "invalid operation context\n";
+        initOperationStatus();
+    }
+
+    // TODO: do we need resource - operation map? or just keep one operation
+    union pldm_rde_op_execution_flags operationExecutionFlags;
+    operationExecutionFlags.byte = 0x0;
+    union pldm_rde_permission_flags permissionFlags;
+    permissionFlags.byte = 0x01;
+    enum pldm_rde_varstring_format etagFormat = PLDM_RDE_VARSTRING_UTF_8;
+    const char etag[] = "etag";
+
+    // not sure the length is correct, we may not receive this command ^_<
+    constexpr size_t responsePayloadLength =
+        sizeof(struct pldm_msg_hdr) +
+        sizeof(struct pldm_rde_operation_status_resp) + 4;
+    Response response(responsePayloadLength, 0);
+    auto responsePtr = reinterpret_cast<pldm_msg*>(response.data());
+    rc = encode_rde_operation_status_resp(
+        request->hdr.instance_id, PLDM_SUCCESS,
+        ctx.operation_ctx->operation_status,
+        ctx.operation_ctx->percentage_complete,
+        ctx.operation_ctx->completion_time, &operationExecutionFlags,
+        ctx.transferHandle, &permissionFlags, 0, etagFormat, etag, NULL,
+        responsePtr);
+    if (rc != PLDM_SUCCESS)
+    {
+        std::cerr << "encode operation status resp failed\n";
+        return CmdHandler::ccOnlyResponse(request, rc);
+    }
+    return response;
+}
