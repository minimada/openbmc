+constexpr size_t MAX_FILE_SIZE = 1 * 1024 * 1024; // 1 MB
+// constexpr uint32_t RDE_SUPPORT_RESOURCE_ID = 0x0;
+// std::vector<uint32_t> resourceIds = {0x0, 0xffffffff};
+const std::string DICT_PATH = "/etc/rde/dict.bin";
+const std::string ANNOTATION_PATH = "/etc/rde/annotation.bin";
+const std::string RDE_DATA_PATH = "/etc/rde/data.bin";
+std::unordered_map<uint32_t, std::string> RESOURCE_MAP = {
+    {0x0, DICT_PATH}, {0xffffffff, ANNOTATION_PATH}};
+
+// load file to context payload for receive command
+int Handler::load(std::string filePath)
+{
+    std::uintmax_t fileSize = 0;
+    try
+    {
+        fileSize = fs::file_size(filePath);
+    }
+    catch (const fs::filesystem_error& e)
+    {
+        lg2::error("Cannot read file: {FILE}, {ERROR}", "FILE", filePath,
+                   "ERROR", e.what());
+        return -1;
+    }
+
+    if (fileSize > MAX_FILE_SIZE)
+    {
+        lg2::error("file size is greater than maximum");
+        return -1;
+    }
+    ctx.payload = std::vector<uint8_t>(fileSize);
+    std::ifstream stream(filePath, std::ios::in | std::ios::binary);
+    stream.read(reinterpret_cast<char*>(ctx.payload.data()), fileSize);
+
+    return (int)fileSize;
+}
