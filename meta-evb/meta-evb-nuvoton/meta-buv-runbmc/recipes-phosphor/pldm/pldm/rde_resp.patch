+Response Handler::getSchemaDictionary(const pldm_msg* request,
+                                      size_t payloadLength)
+{
+    uint8_t dictionaryFormat = 0x00;
+    ctx.transferHandle = 0xAABBCCDD;
+    uint32_t resourceId;
+    uint8_t requestedSchemaClass;
+    auto rc = decode_get_schema_dictionary_req(
+        request, payloadLength, &resourceId, &requestedSchemaClass);
+    if (rc != PLDM_SUCCESS)
+    {
+        return ccOnlyResponse(request, rc);
+    }
+    // check the request resource ID we support it or not
+    std::string filePath;
+    auto rid = RESOURCE_MAP.find(resourceId);
+    if (rid == RESOURCE_MAP.end())
+    {
+        lg2::error("not support resource: {RESOURCE}", "RESOURCE", resourceId);
+        return ccOnlyResponse(request, PLDM_RDE_ERROR_NO_SUCH_RESOURCE);
+    }
+    // currently rded only fetch major class, even annotation dict
+    if (requestedSchemaClass == PLDM_RDE_SCHEMA_MAJOR)
+    {
+        // filePath = DICT_PATH;
+        filePath = rid->second;
+    }
+    else if (requestedSchemaClass == PLDM_RDE_SCHEMA_ANNOTATION)
+    {
+        filePath = ANNOTATION_PATH;
+    }
+    else
+    {
+        lg2::error("not support schema class: {CLASS}", "CLASS",
+                   std::to_string(requestedSchemaClass));
+        return ccOnlyResponse(request, PLDM_RDE_ERROR_NO_SUCH_RESOURCE);
+    }
+    ctx.resourceID = resourceId;
+
+    Response response(sizeof(struct pldm_msg_hdr) +
+                          sizeof(struct pldm_rde_get_schema_dictionary_resp),
+                      0);
+    auto responsePtr = reinterpret_cast<pldm_msg*>(response.data());
+    rc = encode_get_schema_dictionary_resp(request->hdr.instance_id,
+                                           PLDM_SUCCESS, dictionaryFormat,
+                                           ctx.transferHandle, responsePtr);
+    if (rc != PLDM_SUCCESS)
+    {
+        return ccOnlyResponse(request, rc);
+    }
+    // open file for receive command
+    lg2::info("dictionary file: {FILE}", "FILE", filePath);
+    if (load(filePath) > 0)
+    {
+        ctx.responderStatus = PLDM_RDE_RESPONDER_WAITING_FOR_NEXT;
+        ctx.transferred = 0;
+        lg2::info("loaded dict binary");
+    }
+    else
+    {
+        ctx.responderStatus = PLDM_RDE_RESPONDER_REQUEST_FAILED;
+        return ccOnlyResponse(request, PLDM_ERROR);
+    }
+    // print debug message
+    std::cerr << "=== getSchemaDictionary ===" << std::endl;
+    std::cerr << "resourceId :" << resourceId << ", ";
+    std::cerr << "requestedSchemaClass :"
+              << std::to_string(requestedSchemaClass) << std::endl;
+    std::cerr << "file :" << filePath << ", ";
+    std::cerr << "dict format :" << std::to_string(dictionaryFormat)
+              << std::endl;
+    std::cerr << "transferHandle :" << ctx.transferHandle << std::endl;
+
+    return response;
+}
