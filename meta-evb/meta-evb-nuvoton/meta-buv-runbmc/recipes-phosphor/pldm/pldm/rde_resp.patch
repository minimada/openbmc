+Response Handler::RDEOperationInit(const pldm_msg* request,
+                                   size_t payloadLength)
+{
+    uint32_t resourceId;
+    uint16_t operationId;
+    uint8_t operationType;
+    uint8_t completionCode;
+    union pldm_rde_operation_flags operationFlags;
+    uint32_t sendTransferHandle;
+    uint8_t operationLocatorLength;
+    uint32_t requestPayloadLength;
+    uint8_t* operationLocator = std::make_unique<uint8_t>().get();
+    uint8_t* requestPayload = std::make_unique<uint8_t>().get();
+    // check status is valid
+    if (ctx.operation_ctx != NULL &&
+        ctx.operation_ctx->operation_status != PLDM_RDE_OPERATION_INACTIVE)
+    {
+        std::cerr << "operation context should be inactive\n";
+        return CmdHandler::ccOnlyResponse(request, PLDM_ERROR);
+    }
+    auto rc = decode_rde_operation_init_req(
+        request, payloadLength, &resourceId, &operationId, &operationType,
+        &operationFlags, &sendTransferHandle, &operationLocatorLength,
+        &requestPayloadLength, &operationLocator, &requestPayload);
+    if (rc != PLDM_SUCCESS)
+    {
+        std::cerr << "decode init operation reqeust failed\n";
+        return CmdHandler::ccOnlyResponse(request, rc);
+    }
+    std::cerr << "=== RDEOperationInit ===\n";
+    std::cerr << "res ID:" << std::to_string(resourceId) << ", ";
+    std::cerr << "op ID:" << std::to_string(operationId) << "\n";
+    std::cerr << "op type:" << std::to_string(operationType) << ", ";
+    std::cerr << "op flags:" << std::to_string(operationFlags.byte) << ", ";
+    std::cerr << "trans handler:" << std::to_string(sendTransferHandle) << "\n";
+    std::cerr << "op len:" << std::to_string(operationLocatorLength) << ", ";
+    std::cerr << "payload len:" << std::to_string(requestPayloadLength) << "\n";
+
+    auto rid = RESOURCE_MAP.find(resourceId);
+    if (rid == RESOURCE_MAP.end())
+    {
+        return ccOnlyResponse(request, PLDM_RDE_ERROR_NO_SUCH_RESOURCE);
+    }
+    // set decode data to operation ctx
+    auto operation_ctx = std::make_unique<struct rde_operation>();
+    operation_ctx->resource_id = resourceId;
+    operation_ctx->operation_id = operationId;
+    operation_ctx->operation_flags = operationFlags;
+    operation_ctx->send_data_transfer_handle = sendTransferHandle;
+    operation_ctx->operation_locator_length = operationLocatorLength;
+    operation_ctx->request_payload_length = requestPayloadLength;
+    operation_ctx->operation_locator = operationLocator;
+    operation_ctx->request_payload = requestPayload;
+    // handle operation
+    union pldm_rde_op_execution_flags operationExecutionFlags;
+    union pldm_rde_permission_flags permissionFlags;
+    // we are now only support read
+    if (operationType == PLDM_RDE_OPERATION_READ)
+    {
+        // operation data for response
+        completionCode = PLDM_SUCCESS;
+        operation_ctx->operation_status = PLDM_RDE_OPERATION_COMPLETED;
+        operation_ctx->percentage_complete = 100;
+        operation_ctx->completion_time = 0x0;
+        operationExecutionFlags.bits.have_result_payload = 0x1;
+        // perform load data
+        if (load(RDE_DATA_PATH) <= 0)
+            return ccOnlyResponse(request, PLDM_ERROR);
+        operation_ctx->resp_payload_length = ctx.payload.size();
+    }
+    else
+    {
+        completionCode = PLDM_RDE_ERROR_UNSUPPORTED;
+        operation_ctx->operation_status = PLDM_RDE_OPERATION_FAILED;
+        operation_ctx->percentage_complete = 0;
+        operation_ctx->completion_time = 0xffffffff;
+        operationExecutionFlags.bits.have_result_payload = 0x0;
+        operation_ctx->resp_payload_length = 0;
+    }
+    // assume we won't have next payload
+    operation_ctx->result_transfer_handle = 0x0;
+    permissionFlags.bits.read_allowed = 1;
+    operation_ctx->resp_operation_flags = &operationExecutionFlags;
+    operation_ctx->resp_permission_flags = &permissionFlags;
+    enum pldm_rde_varstring_format etagFormat = PLDM_RDE_VARSTRING_UTF_8;
+    const char etag[] = "etag";
+    std::cerr << "resp payload len:"
+              << std::to_string(operation_ctx->resp_payload_length) << ", ";
+    std::cerr << "cc:" << std::to_string(completionCode) << "\n";
+
+    // header + resp + etag + payload size
+    const size_t responseSize = sizeof(struct pldm_msg_hdr) +
+                                sizeof(struct pldm_rde_operation_init_resp) +
+                                sizeof(struct pldm_rde_varstring) +
+                                strlen(etag) + 1 /* var string end null*/ +
+                                operation_ctx->resp_payload_length;
+    // TODO: implement move to multipart receive if playload size over limit.
+    Response response(responseSize, 0);
+    auto responsePtr = reinterpret_cast<pldm_msg*>(response.data());
+    rc = encode_rde_operation_init_resp(
+        request->hdr.instance_id, completionCode,
+        operation_ctx->operation_status, operation_ctx->percentage_complete,
+        operation_ctx->completion_time, operation_ctx->resp_operation_flags,
+        operation_ctx->result_transfer_handle,
+        operation_ctx->resp_permission_flags,
+        operation_ctx->resp_payload_length, etagFormat, etag,
+        ctx.payload.data(), responsePtr);
+    if (rc != PLDM_SUCCESS)
+    {
+        std::cerr << "encode init operation resp failed\n";
+        return CmdHandler::ccOnlyResponse(request, rc);
+    }
+    ctx.operation_ctx = std::move(operation_ctx);
+    return response;
+}
+
+Response Handler::RDEOperationComplete(const pldm_msg* request,
+                                       size_t payloadLength)
+{
+    uint32_t resourceId;
+    uint16_t operationId;
+    auto rc = decode_rde_operation_complete_req(request, payloadLength,
+                                                &resourceId, &operationId);
+    if (rc != PLDM_SUCCESS)
+    {
+        std::cerr << "decode complete operation failed\n";
+        return CmdHandler::ccOnlyResponse(request, rc);
+    }
+    constexpr size_t responseSize =
+        sizeof(struct pldm_msg_hdr) +
+        sizeof(struct pldm_rde_operation_complete_resp);
+    Response response(responseSize, 0);
+    auto responsePtr = reinterpret_cast<pldm_msg*>(response.data());
+    uint32_t completionCode = PLDM_SUCCESS;
+    if (ctx.operation_ctx != NULL)
+    {
+        std::cerr << "=== RDEOperationComplete ===\n";
+        std::cerr << "res ID:" << std::to_string(resourceId) << ", ";
+        std::cerr << "op ID:" << std::to_string(operationId) << "\n";
+        std::cerr << "op status: "
+                  << std::to_string(ctx.operation_ctx->operation_status)
+                  << "\n";
+        if (ctx.operation_ctx->operation_status !=
+                PLDM_RDE_OPERATION_COMPLETED ||
+            ctx.operation_ctx->resource_id != resourceId ||
+            ctx.operation_ctx->operation_id != operationId)
+        {
+            completionCode = PLDM_RDE_ERROR_UNSUPPORTED;
+            std::cerr << "invalid state or ID\n";
+        }
+        else
+        {
+            // normal case, reset status for next operation
+            std::cerr << "normal completion\n";
+        }
+        // no matter errors, for next operation work
+        ctx.operation_ctx->operation_status = PLDM_RDE_OPERATION_INACTIVE;
+    }
+    else
+        completionCode = PLDM_RDE_ERROR_UNSUPPORTED;
+    rc = encode_rde_operation_complete_resp(request->hdr.instance_id,
+                                            completionCode, responsePtr);
+    if (rc != PLDM_SUCCESS)
+    {
+        std::cerr << "encode complete operation resp failed\n";
+        return CmdHandler::ccOnlyResponse(request, rc);
+    }
+    return response;
+}
+
