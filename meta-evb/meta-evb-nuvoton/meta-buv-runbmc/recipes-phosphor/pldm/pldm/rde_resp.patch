+Response Handler::negotiateRedfishParameters(const pldm_msg* request,
+                                             size_t /*payloadLength*/)
+{
+    constexpr const char* device = "RDE test device";
+    uint8_t deviceConcurrencySupport = 1;
+    bitfield8_t deviceCapabilitiesFlags = {.byte = 0x3F};
+    bitfield16_t deviceFeatureSupport = {.value = 0x7389};
+    uint32_t deviceConfigurationSignature = 0xABCDEF12;
+    Response response(
+        sizeof(struct pldm_msg_hdr) +
+            sizeof(struct pldm_rde_negotiate_redfish_parameters_resp) + 16,
+        0);
+    auto responsePtr = reinterpret_cast<pldm_msg*>(response.data());
+    auto rc = encode_negotiate_redfish_parameters_resp(
+        request->hdr.instance_id, PLDM_SUCCESS, deviceConcurrencySupport,
+        deviceCapabilitiesFlags, deviceFeatureSupport,
+        deviceConfigurationSignature, device, PLDM_RDE_VARSTRING_ASCII,
+        responsePtr);
+    if (rc != PLDM_SUCCESS)
+    {
+        return ccOnlyResponse(request, rc);
+    }
+    return response;
+}
+
+Response Handler::negotiateMediumParameters(const pldm_msg* request,
+                                            size_t payloadLength)
+{
+    uint32_t mcMaxChunkSize;
+    auto rc = decode_negotiate_medium_parameters_req(request, payloadLength,
+                                                     &mcMaxChunkSize);
+    lg2::info("MC max transfer chunk size:{CHUNK}", "CHUNK", mcMaxChunkSize);
+    // spec ask that, should not happen
+    if (mcMaxChunkSize < PLDM_RDE_MIN_TRANSFER_SIZE_BYTES)
+        return ccOnlyResponse(request, PLDM_ERROR_INVALID_DATA);
+    // update max chunk size if greater than MC one
+    if (mcMaxChunkSize < RESPONDER_DEVICE_MAX_TRANSFER_CHUNK_SIZE)
+        ctx.transferChunkSize = mcMaxChunkSize;
+    lg2::info("used transfer chunk size:{CHUNK}", "CHUNK",
+              ctx.transferChunkSize);
+
+    Response response(
+        sizeof(struct pldm_msg_hdr) +
+            sizeof(struct pldm_rde_negotiate_medium_parameters_resp),
+        0);
+    auto responsePtr = reinterpret_cast<pldm_msg*>(response.data());
+    rc = encode_negotiate_medium_parameters_resp(
+        request->hdr.instance_id, PLDM_SUCCESS,
+        RESPONDER_DEVICE_MAX_TRANSFER_CHUNK_SIZE, responsePtr);
+    if (rc != PLDM_SUCCESS)
+    {
+        return ccOnlyResponse(request, rc);
+    }
+    return response;
+}
