+void removeBaseContext(std::string_view rdeDevice)
+{
+    auto it = udevIdToBaseDiscContextMap.find(rdeDevice);
+    if (it != udevIdToBaseDiscContextMap.end())
+    {
+        udevIdToBaseDiscContextMap.erase(rdeDevice);
+    }
+}
+
+std::optional<struct requester_base_context*>
+    getBaseContext(std::string_view rdeDevice)
+{
+    auto it = udevIdToBaseDiscContextMap.find(rdeDevice);
+    if (it != udevIdToBaseDiscContextMap.end())
+    {
+        return it->second.get();
+    }
+    std::cerr << "Base context not found for device: " << rdeDevice
+              << std::endl;
+    return std::nullopt;
+}
