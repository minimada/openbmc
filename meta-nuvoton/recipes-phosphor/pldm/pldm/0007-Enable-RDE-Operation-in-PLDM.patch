+        return 0;
+    }
+    if ((uri.find("Cables") == std::string::npos) &&
+        (uri.find("Systems") == std::string::npos))
+    {
+        std::cerr << "Resource id not found for uri: " << uri << std::endl;
+    }
+    return 1;
