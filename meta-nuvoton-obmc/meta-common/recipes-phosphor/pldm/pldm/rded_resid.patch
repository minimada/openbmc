+
+// replace %Lxxxxxx with resourceIdMap value
+std::string replaceOdataId(const std::string& str)
+{
+    // std::string result;
+    size_t pos = 0;
+    size_t start = 0, end = 0;
+    uint32_t i;
+    std::stringstream ss;
+    const char* sp = str.c_str();
+    while ((pos = str.find("%L", start)) != std::string::npos)
+    {
+        ss << std::string_view(sp + start, pos - start);
+        end = str.find_first_not_of("0123456789", pos + 2);
+        if (end == std::string::npos)
+        {
+            end = str.size();
+        }
+        std::string_view id(sp + pos + 2, end - pos - 2);
+        // std::cout << "id:" << id << std::endl;
+        i = (uint32_t)atoi(id.data());
+        if (errno == ERANGE)
+        {
+            std::cerr << "atoi overflow, errno: " << errno << std::endl;
+            errno = 0;
+        }
+        auto it = resourceIdMap.begin();
+        for (; it != resourceIdMap.end(); ++it)
+        {
+            if (it->second == i)
+            {
+                ss << it->first;
+                break;
+            }
+        }
+        if (it == resourceIdMap.end())
+        {
+            ss << "%L" << i;
+            std::cout << "resource id 0x" << std::hex << i << " not found"
+                      << std::endl;
+        }
+        start = end;
+    }
+    // handle remain string
+    ss << str.substr(start);
+    return ss.str();
+}
