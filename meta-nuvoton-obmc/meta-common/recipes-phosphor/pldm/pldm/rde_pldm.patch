+
+namespace pldm
+{
+
+namespace responder
+{
+
+namespace rde
+{
+
+typedef enum rde_responder_status
+{
+    PLDM_RDE_RESPONDER_REQUEST_FAILED = -1,
+    PLDM_RDE_RESPONDER_READY = 0,
+    PLDM_RDE_RESPONDER_WAITING_FOR_NEXT = 1,
+    PLDM_RDE_RESPONDER_NO_PENDING_ACTION = 2
+} rde_res_status_t;
+
+// TODO: update the maximum chunk size as spec.
+// 64KB
+// constexpr uint32_t RESPONDER_DEVICE_MAX_TRANSFER_CHUNK_SIZE = 0x00010000;
+// use the value same as MC to prevent handle "throttle down"
+// 2048 define in rded/helper/common.hpp PLDM_MAX_REQUEST_BYTES;
+constexpr uint32_t RESPONDER_DEVICE_MAX_TRANSFER_CHUNK_SIZE = 1024;
+
+/**
+ * @brief RDE Responder context
+ */
+struct pldm_rde_responder_context
+{
+    uint8_t contextStatus;
+    // int next_command;
+    uint8_t responderStatus;
+    uint32_t resourceID;
+    uint32_t transferHandle;
+    uint32_t transferChunkSize;
+    size_t transferred;
+    std::vector<uint8_t> payload;
+    std::unique_ptr<struct rde_operation> operation_ctx;
+};
+
+class Handler : public CmdHandler
+{
+  public:
+    /** @brief Constructor
+     *
+     */
+    Handler()
+    {
+        handlers.emplace(
+            PLDM_NEGOTIATE_REDFISH_PARAMETERS,
+            [this](pldm_tid_t, const pldm_msg* request, size_t payloadLength) {
+            return this->negotiateRedfishParameters(request, payloadLength);
+        });
+        handlers.emplace(
+            PLDM_NEGOTIATE_MEDIUM_PARAMETERS,
+            [this](pldm_tid_t, const pldm_msg* request, size_t payloadLength) {
+            return this->negotiateMediumParameters(request, payloadLength);
+        });
+        handlers.emplace(
+            PLDM_GET_SCHEMA_DICTIONARY,
+            [this](pldm_tid_t, const pldm_msg* request, size_t payloadLength) {
+            return this->getSchemaDictionary(request, payloadLength);
+        });
+        handlers.emplace(
+            PLDM_RDE_MULTIPART_RECEIVE,
+            [this](pldm_tid_t, const pldm_msg* request, size_t payloadLength) {
+            return this->multipartReceive(request, payloadLength);
+        });
+        handlers.emplace(
+            PLDM_RDE_OPERATION_INIT,
+            [this](pldm_tid_t, const pldm_msg* request, size_t payloadLength) {
+            return this->RDEOperationInit(request, payloadLength);
+        });
+        handlers.emplace(
+            PLDM_RDE_OPERATION_COMPLETE,
+            [this](pldm_tid_t, const pldm_msg* request, size_t payloadLength) {
+            return this->RDEOperationComplete(request, payloadLength);
+        });
+        handlers.emplace(
+            PLDM_RDE_OPERATION_STATUS,
+            [this](pldm_tid_t, const pldm_msg* request, size_t payloadLength) {
+            return this->RDEOperationStatus(request, payloadLength);
+        });
+        handlers.emplace(
+            PLDM_RDE_OPERATION_KILL,
+            [this](pldm_tid_t, const pldm_msg* request, size_t payloadLength) {
+            return this->RDEOperationKill(request, payloadLength);
+        });
+        std::cerr << "RDE handler register" << std::endl;
+        initResponderContext();
+        std::cerr << "0122 modified 1" << std::endl;
+    }
+
+    // RDE initialize command handlers
+    Response negotiateRedfishParameters(const pldm_msg* request,
+                                        size_t payloadLength);
+    Response negotiateMediumParameters(const pldm_msg* request,
+                                       size_t payloadLength);
+    Response getSchemaDictionary(const pldm_msg* request, size_t payloadLength);
+    Response multipartReceive(const pldm_msg* request, size_t payloadLength);
+
+    // RDE operation handlers
+    Response RDEOperationInit(const pldm_msg* request, size_t payloadLength);
+    Response RDEOperationComplete(const pldm_msg* request,
+                                  size_t payloadLength);
+    Response RDEOperationStatus(const pldm_msg* request, size_t payloadLength);
+    Response RDEOperationKill(const pldm_msg* request, size_t payloadLength);
+
+    int load(std::string filePath);
+    void initOperationStatus();
+
+    void initResponderContext()
+    {
+        ctx.contextStatus = CONTEXT_FREE;
+        ctx.responderStatus = PLDM_RDE_RESPONDER_READY;
+        ctx.transferred = 0;
+        ctx.transferChunkSize = RESPONDER_DEVICE_MAX_TRANSFER_CHUNK_SIZE;
+    };
+
+  private:
+    struct pldm_rde_responder_context ctx;
+}; // class handler
+
+} // namespace rde
+} // namespace responder
+} // namespace pldm
